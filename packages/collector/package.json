{
  "name": "agents-devtools",
  "version": "0.1.0",
  "description": "Local DevTools for Cloudflare Agents SDK observability events. Unofficial community tool, not affiliated with Cloudflare.",
  "keywords": ["cloudflare", "agents", "durable-objects", "devtools", "observability"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quant-TheodoreFelix/agents-devtools.git"
  },
  "homepage": "https://github.com/Quant-TheodoreFelix/agents-devtools#readme",
  "bugs": "https://github.com/Quant-TheodoreFelix/agents-devtools/issues",
  "type": "module",
  "bin": {
    "agents-devtools": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": ["dist", "ui-dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node scripts/prepack.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agents-devtools/client": "workspace:*",
    "@agents-devtools/protocol": "workspace:*",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "agents": ">=0.7.0 <1"
  },
  "peerDependenciesMeta": {
    "agents": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
